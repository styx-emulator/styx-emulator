# For reference, this file is from: tests/tcg/hexagon/Makefile.target
.PHONY: all

CC = $(addprefix $(CCPATH),clang)
AR = $(addprefix $(CCPATH),llvm-ar)
RANLIB = $(addprefix $(CCPATH),llvm-ranlib)

INCLUDES = -I standalone_systests -I standalone_systests/include -I standalone_systests/crt0

CFLAGS += -Wno-incompatible-pointer-types -Wno-undefined-internal
CFLAGS += -fno-unroll-loops -fno-stack-protector
CFLAGS += -Wall -O2 -g -fno-strict-aliasing -mv71

HEXFLAGS += -DLOG2VLEN=7 -DQDSP6SS_PUB_BASE=0xFE200000 -DCSR_BASE=0xfc900000 -DQTMR_FREQ=19200000 -DIRQ1=3 -DIRQ2=4

ASSEMBLE_CFLAGS += -nostartfiles

VPATH += standalone_systests/src
VPATH += standalone_systests/crt0

# General recipes

OBJDIR = build/objs
TESTDIR = build

$(OBJDIR):
	mkdir -p $(OBJDIR)

$(OBJDIR)/%.o: %.c $(OBJDIR)
	$(CC) -c $(CFLAGS) $(HEXFLAGS) $(INCLUDES) $< -o $@
$(OBJDIR)/%.o: %.S $(OBJDIR)
	$(CC) -c $(CFLAGS) $(INCLUDES) $^ -o $@

# For the test cases
$(TESTDIR)/%: $(OBJDIR)/%.o $(OBJDIR)/crt.a
	$(CC) $(CFLAGS) $(ASSEMBLE_CFLAGS) $(OBJDIR)/crt.a $< -o $@

# Build the runtime
_CRTDEPS = min_libc.o int.o tlb.o crt0.o crt0_standalone.o pte.o # test-thread.o
CRTDEPS = $(patsubst %, $(OBJDIR)/%, $(_CRTDEPS))
$(OBJDIR)/crt.a: $(CRTDEPS) $(OBJDIR)
	$(AR) qc $(OBJDIR)/crt.a $(CRTDEPS)
	$(RANLIB) $(OBJDIR)/crt.a


